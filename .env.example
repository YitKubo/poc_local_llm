# Copy to .env and edit. .env is gitignored.
#   cp .env.example .env   (then replace the CHANGE_ME values, e.g. `openssl rand -hex 24`)

# --- Model (fetched by scripts/fetch_model.sh) -------------------------------
MODEL_FILE=Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
MODEL_URL=https://huggingface.co/bartowski/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
# Lighter alternative:
#   MODEL_FILE=Llama-3.2-1B-Instruct-Q4_K_M.gguf
#   MODEL_URL=https://huggingface.co/bartowski/Llama-3.2-1B-Instruct-GGUF/resolve/main/Llama-3.2-1B-Instruct-Q4_K_M.gguf

# llama.cpp --alias. Must equal the part after "openai/" in litellm_config.yaml.
# (LiteLLM cannot interpolate env vars inside a string, so that file is hardcoded.)
MODEL_ALIAS=Qwen2.5-1.5B-Instruct

# --- llama.cpp: slots and sizing (see docs/RESULTS.md for how these were chosen) ---
# Number of concurrent slots (continuous batching). Measured on this box (docs/RESULTS.md):
# aggregate throughput stays ~25 tok/s no matter how many run at once, so slots only decide
# how that fixed capacity is divided. 4 keeps each user at ~6 tok/s; 8 drops them to ~3.
LLAMA_PARALLEL=4
# TOTAL context shared by all slots (we pass --kv-unified, so this is a shared pool,
# not divided by LLAMA_PARALLEL).
LLAMA_CTX=16384
# Physical cores. Threads are shared by all slots; this is NOT slots x threads.
# Measured: 6 and 4 are equivalent within noise; 12 (all SMT threads) is several times SLOWER.
LLAMA_THREADS=6

# --- Secrets -----------------------------------------------------------------
# llama.cpp internal token (only LiteLLM knows it; llama.cpp is not published to the host)
LLAMA_API_KEY=CHANGE_ME
# LiteLLM admin key (also the /ui password). Must start with "sk-".
LITELLM_MASTER_KEY=sk-CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# --- Per-key backstop limits (used by scripts/create_keys.sh) -----------------
# REQUIRED, not just a backstop: requests beyond the slot count wait in llama.cpp's own FIFO,
# which does not distinguish users. Keep this below LLAMA_PARALLEL (here half), otherwise one
# user can take every slot and everyone else queues behind them.
MAX_PARALLEL_REQUESTS=2
RPM_LIMIT=30
TPM_LIMIT=40000
# Daily budget in nominal currency. Tokens are mapped to money by
# input/output_cost_per_token in litellm_config.yaml (1e-7 per token) so
# 0.4 == 4,000,000 tokens/day.
DAILY_BUDGET=0.4
