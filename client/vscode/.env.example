# Copy to .env and edit. .env is gitignored -- this is the ONLY file where the key goes.
#   cp .env.example .env    (then set LLM_SERVER_KEY)
#   ./apply.sh              (writes VS Code's chatLanguageModels.json; nothing tracked by git is touched)
# Never put the key in chatLanguageModels.sample.json or any other file in this repo.

# --- Server (same 3 values as client/install.sh) -----------------------------
LLM_SERVER_URL=http://localhost:4000
# The VS Code-only key issued by the server admin (server/scripts/create_keys.sh vscode).
LLM_SERVER_KEY=sk-REPLACE_WITH_YOUR_VSCODE_KEY
CLIENT_MODEL=local-qwen

# --- Limits (see docs/RESULTS.md section 8 for why 8000) ---------------------
MAX_INPUT_TOKENS=8000
MAX_OUTPUT_TOKENS=2048

# --- Where to write ----------------------------------------------------------
# VS Code profile name. Create it first in VS Code: "Profiles: Create Profile..." (Empty).
# Leave empty to write to the Default profile.
VSCODE_PROFILE=local-llm
# VS Code's "User" directory. Auto-detected (WSL -> Windows %APPDATA%\Code\User, Linux, macOS).
# Set it only if auto-detection fails or you use Insiders/VSCodium.
#   VSCODE_USER_DIR=/mnt/c/Users/<you>/AppData/Roaming/Code/User
